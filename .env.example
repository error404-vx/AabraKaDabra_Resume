# Copy to .env and adjust. All values are optional.
PORT=5175
HOST=127.0.0.1

# Optional AI writer (any OpenAI-compatible Chat Completions API: OpenAI, Azure OpenAI v1, Ollama, etc.).
# Without a key, the built-in rules engine writes the resume.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Only for local testing: allow fetching private/intranet URLs (disables SSRF protection).
ALLOW_PRIVATE_URLS=false
